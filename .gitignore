# --- Secrets ---
.env
.streamlit/secrets.toml

# --- Python ---
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
.pytest_cache/

# --- Model artifacts (audit #17) ---
# model/flood_detector.pth and its .sha256 sidecar ARE tracked (plain git, see
# .gitattributes). Phase 1 ignored model/*.pth, so every fresh clone and every
# Streamlit Cloud deploy started with a dead Threat Analysis tab.
# Only scratch checkpoints from experiments are ignored.
model/*.tmp.pth
model/experiments/

# --- Training outputs ---
# images/ (curves, confusion matrix, final_metrics.json, split_manifest.json,
# dataset_summary.json) is tracked: the dashboard displays it and it must match
# the committed checkpoint. Regenerate them together with train_pipeline.py.

# --- Datasets (regenerated by scripts) ---
# data/: generate_synthetic_data.py --seed 42
# data_raw/: prepare_sen1floods11.py downloads (~1 GB)
# data_real/: prepare_sen1floods11.py tiles
data/
data_raw/
data_real/

# --- Local archive of pre-Phase-2 sources (kept out of history) ---
_phase1_backup/

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- Colab / Jupyter ---
.ipynb_checkpoints/
